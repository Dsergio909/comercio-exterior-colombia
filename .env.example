# Copia este archivo como .env y llena los valores. El .env nunca sube a GitHub.

# Postgres (solo para n8n en Docker)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# IA local
# Vacío = el Ollama de tu PC. Con Docker, docker-compose.yml usa
# http://host.docker.internal:11434 (127.0.0.1 sería el propio contenedor de n8n).
OLLAMA_URL=
OLLAMA_MODELO=qwen3.5:9b

# Pipeline (PIPELINE_ARGS=--muestra usa los datos ficticios)
PIPELINE_ARGS=

# Avisos por Telegram (opcional). Sin estos dos valores, los flujos no avisan por Telegram.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
