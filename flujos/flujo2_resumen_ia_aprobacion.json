              "id": "d2000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $env.TELEGRAM_TOKEN || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000014",
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.texto_aviso }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000015",
      "name": "Esperar la decisión de Sergio",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2640,
        0
      ],
      "webhookId": "5d0e6b8e-1c1a-4f3e-9a52-ce0000000003",
      "parameters": {
        "resume": "form",
        "formTitle": "={{ 'Resumen de exportaciones · ' + $('Leer texto guardado').first().json.periodo }}",
        "formDescription": "={{ $('Leer texto guardado').first().json.texto + '\\n\\n' + $('Leer texto guardado').first().json.control }}",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Decisión",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Aprobar"
                  },
                  {
                    "option": "Corregir"
                  },
                  {
                    "option": "Rechazar"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Texto corregido (solo si eliges Corregir)",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Comentario",
              "fieldType": "text"
            }
          ]
        },
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 7,
        "resumeUnit": "days",
        "options": {
          "appendAttribution": false,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Decisión guardada. Si aprobaste o corregiste, el resumen pasa otra vez por el control de números antes de publicarse."
            }
          }
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000016",
      "name": "Traducir decisión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "jsCode": "const f = $json;\nconst mapa = { 'Aprobar': 'aprobado', 'Corregir': 'corregido', 'Rechazar': 'rechazado' };\nconst decision = mapa[f['Decisión']] || 'rechazado';\nconst comentario = f['Comentario'] || (f['Decisión'] ? '' : 'Venció el plazo de 7 días sin respuesta');\nreturn [{ json: { id: $('Leer texto guardado').first().json.id, decision, texto_final: f['Texto corregido (solo si eliges Corregir)'] || '', comentario } }];"
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000017",
      "name": "Guardar decisión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.PIPELINE_URL || 'http://127.0.0.1:5688') + '/resumen/decidir' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000018",
      "name": "Registrar decisión",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3300,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.PIPELINE_URL || 'http://127.0.0.1:5688') + '/corrida' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ flujo: 'n8n-flujo2', paso: 'decisión', estado: $json.ok ? 'ok' : 'aviso', detalle: JSON.stringify({ decision: $('Traducir decisión').first().json.decision, resultado: $json }) }) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
