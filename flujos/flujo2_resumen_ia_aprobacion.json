  "nodes": [
    {
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Pedir resumen (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "5d0e6b8e-1c1a-4f3e-9a52-ce0000000002",
