{
  "id": "ceAvisoError0001",
  "name": "Comercio exterior 0 · Aviso cuando un flujo falla",
  "active": false,
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota" },
  "nodes": [
    {
      "id": "e0000000-0000-4000-8000-000000000001",
      "name": "Cuando un flujo falla",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "e0000000-0000-4000-8000-000000000002",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const e = $json;\nconst flujo = (e.workflow && e.workflow.name) || 'flujo';\nconst nodo = (e.execution && e.execution.lastNodeExecuted) || '?';\nconst msg = (e.execution && e.execution.error && e.execution.error.message) || 'sin detalle';\nreturn [{ json: { texto: `Falló «${flujo}» en el paso «${nodo}»: ${msg}`, ejecucion: e.execution && e.execution.id } }];"
      }
    },
    {
      "id": "e0000000-0000-4000-8000-000000000003",
      "name": "Registrar error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.PIPELINE_URL || 'http://127.0.0.1:5688') + '/corrida' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ flujo: 'n8n-errores', paso: 'error', estado: 'error', detalle: $json.texto }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "e0000000-0000-4000-8000-000000000004",
      "name": "¿Hay Telegram configurado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "f0000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $env.TELEGRAM_TOKEN || '' }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e0000000-0000-4000-8000-000000000005",
      "name": "Avisar por Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 200],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_TOKEN + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: 'Comercio exterior · ' + $json.texto }) }}",
        "options": { "timeout": 30000 }
      }
    }
  ],
  "connections": {
    "Cuando un flujo falla": { "main": [ [ { "node": "Armar mensaje", "type": "main", "index": 0 } ] ] },
    "Armar mensaje": {
      "main": [ [
        { "node": "Registrar error", "type": "main", "index": 0 },
        { "node": "¿Hay Telegram configurado?", "type": "main", "index": 0 }
      ] ]
    },
    "¿Hay Telegram configurado?": { "main": [ [ { "node": "Avisar por Telegram", "type": "main", "index": 0 } ], [] ] }
  },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": true }
}
